# Canonical public origin used for canonical URLs, Open Graph, structured data and the sitemap.
VITE_SITE_URL=https://xposurelb.com

# Set to true ONLY for the approved production deployment. Anything else builds a
# noindex preview (robots.txt Disallow, meta robots noindex, X-Robots-Tag header).
VITE_SITE_INDEXABLE=false

# Google Tag Manager container ID, e.g. GTM-ABC1234. Leave empty for no analytics.
# When set, a consent banner appears and GTM loads only after the visitor accepts.
VITE_GTM_ID=
