# Canonical public origin used for canonical URLs, Open Graph, structured data and the sitemap.
VITE_SITE_URL=https://xposurelb.com

# Set to true ONLY for the approved production deployment. Anything else builds a
# noindex preview (robots.txt Disallow, meta robots noindex, X-Robots-Tag header).
VITE_SITE_INDEXABLE=false

# Google Tag Manager container ID, e.g. GTM-ABC1234. Leave empty for no analytics.
# When set, a consent banner appears and GTM loads only after the visitor accepts.
VITE_GTM_ID=

# ---------------------------------------------------------------------------
# Server (npm run dev / npm start). Read at start-up.
# ---------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# Where the database (xposure.db) and uploaded images live. Keep it on a persistent disk and back it up.
# DATA_DIR=data

# Public address of the website. Recommended in production.
# PUBLIC_ORIGIN=https://xposurelb.com

# Behind a reverse proxy (Nginx, a load balancer, Render, Railway…), so rate limits see real IPs.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# First admin account, created on the first start if there is none. Remove the password afterwards.
# ADMIN_EMAIL=you@xposurelb.com
# ADMIN_PASSWORD=a-long-password-of-at-least-10-characters

# Optional: Zoom Server-to-Server OAuth app (marketplace.zoom.us), so the admin panel creates
# meeting links in one click. Scopes: meeting:write:meeting:admin, meeting:delete:meeting:admin
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_USER_ID=host@xposurelb.com
