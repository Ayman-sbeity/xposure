{
  "name": "xposure-redesign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server/src server/src/index.ts",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build && vite build --ssr client/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "start": "node server/src/index.ts --production",
    "test": "node --test \"server/test/**/*.test.ts\"",
    "admin": "node server/src/cli.ts",
    "preview:static": "vite preview --host 0.0.0.0",
    "deploy": "node scripts/deploy.mjs",
    "deploy:setup": "node scripts/deploy.mjs setup",
    "deploy:rollback": "node scripts/deploy.mjs rollback",
    "deploy:status": "node scripts/deploy.mjs status",
    "deploy:logs": "node scripts/deploy.mjs logs",
    "deploy:backup": "node scripts/deploy.mjs backup"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
