[Unit]
Description=Xposure website and admin panel
Documentation=file:///srv/xposure/current/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/xposure/current

[Service]
Type=simple
User=xposure
Group=xposure
WorkingDirectory=/srv/xposure/current
EnvironmentFile=/etc/xposure/xposure.env
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node server/src/index.ts --production
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0027

# Sandbox: the site can read its code and write only its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xposure
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
